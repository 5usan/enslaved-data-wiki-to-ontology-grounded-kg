# Fuseki assembler: inference endpoint for the Enslaved KG.
#
# Serves a SECOND, read endpoint  /Enslaved-inf  over the SAME TDB2 store as
# your existing /Enslaved-dataset, but wrapped in a reasoner so that querying a
# super-property (e.g. :hasAgentRecord) returns every asserted sub-property
# triple (:hasPersonRecord, :hasAgeRecord, :hasRaceRecord, ...) as well.
#
# Your fast, raw endpoint stays untouched — point phase-1/2 scripts at it as
# before, and use /Enslaved-inf only for the roll-up queries.
#
# Launch:  fuseki-server --conf enslaved-inf.ttl
# (or drop this file in FUSEKI_BASE/run/configuration/ and restart Fuseki)

@prefix :       <#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix ja:     <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix tdb2:   <http://jena.apache.org/2016/tdb#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<#service> a fuseki:Service ;
    fuseki:name     "Enslaved-inf" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset  <#infDataset> .

<#infDataset> a ja:RDFDataset ;
    ja:defaultGraph <#infModel> .

# --- Reasoner -----------------------------------------------------------------
# GenericRuleReasoner loaded with a 2-rule ruleset (subproperty.rules) that does
# ONLY subPropertyOf roll-up. This is deliberately narrower than full RDFS: it
# skips subClassOf / domain / range materialization, which keeps the deduction
# cache small — the right trade-off at your data volume.
#
# The rules read the rdfs:subPropertyOf axioms from the base graph, so the
# ontology (enslaved-v2.ttl) MUST be loaded into the Enslaved-dataset TDB store
# alongside the data. It is tiny; load it once (see notes below) if it isn't there.

<#infModel> a ja:InfModel ;
    ja:baseModel <#baseModel> ;
    ja:reasoner [
        ja:reasonerURL <http://jena.hpl.hp.com/2003/GenericRuleReasoner> ;
        ja:rulesFrom "file:///D:/Study/Masters/GraphRAG/wiki-to-ontology-grounded-kg/fuseki/subproperty.rules"
    ] .

# --- Full-RDFS alternative ----------------------------------------------------
# If you'd rather have ALL RDFS entailments live (subclass + domain/range +
# subproperty), replace the reasoner block above with this and delete the
# rules file. Heavier at your scale.
#
#   ja:reasoner [ ja:reasonerURL
#       <http://jena.hpl.hp.com/2003/RDFSExptRuleReasoner> ] .

# --- Base data (your existing TDB2 store) -------------------------------------
# Point this at the SAME location your /Enslaved-dataset currently uses.
# Find it in your current config, or in FUSEKI_BASE/run/databases/Enslaved-dataset.

<#baseModel> a tdb2:GraphTDB2 ;
    tdb2:dataset <#tdbDataset> .

<#tdbDataset> a tdb2:DatasetTDB2 ;
    tdb2:location "REPLACE_WITH_PATH_TO_YOUR_TDB2_STORE" .
