@prefix : <https://enslaved.org/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shocc: <http://enslaved.org/shapes/occupation-record#> .

#   shacl validate --shapes src/phase5/shapes/occupation_record_shapes.ttl --data out/phase3/occupation_record.ttl --data out/phase3/cv_individuals.ttl --data out/phase3/temporal_extent.ttl --data out/phase3/event.ttl --data out/phase3/agent.ttl --data out/phase3/entity_with_provenance-old.ttl --data ontology/enslaved-v2.ttl | Out-File -Encoding utf8 out/phase5/occupation_record_report.ttl

shocc:OccupationRecordShape
    a sh:NodeShape ;
    sh:targetClass :OccupationRecord ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shocc:hasValue ,
                shocc:hasDescriptiveOccupation ,
                shocc:hasTemporalExtent ,
                shocc:owningAgent ,
                shocc:isDirectlyBasedOn ,
                shocc:recordedAt ,
                shocc:reportsOn .

shocc:hasValue
    a sh:PropertyShape ;
    sh:path :hasValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class :Occupations ;
    sh:message "OccupationRecord must have exactly one :hasValue, typed :Occupations." .

shocc:hasDescriptiveOccupation
    a sh:PropertyShape ;
    sh:path :hasDescriptiveOccupation ;
    sh:datatype xsd:string ;
    sh:message "OccupationRecord :hasDescriptiveOccupation values must be xsd:string." .


shocc:hasTemporalExtent
    a sh:PropertyShape ;
    sh:path :hasTemporalExtent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:class :TemporalExtent ] [ sh:class :TimeSpan ] ) ;
    sh:severity sh:Warning ;
    sh:message "OccupationRecord must have exactly one :hasTemporalExtent, typed :TemporalExtent or :TimeSpan." .

shocc:owningAgent
    a sh:PropertyShape ;
    sh:path [ sh:inversePath [ sh:alternativePath ( :hasOccupationRecord :hasPersonRecord :hasAgentRecord ) ] ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:class :Person ] [ sh:class :Organization ] [ sh:class :Agent ] ) ;
    sh:message "OccupationRecord must be owned by exactly one Agent." .

shocc:isDirectlyBasedOn
    a sh:PropertyShape ;
    sh:path :isDirectlyBasedOn ;
    sh:maxCount 1 ;
    sh:class :EntityWithProvenance ;
    sh:message "OccupationRecord must have at most one :isDirectlyBasedOn, typed :EntityWithProvenance." .

shocc:recordedAt
    a sh:PropertyShape ;
    sh:path :recordedAt ;
    sh:maxCount 1 ;
    sh:class :Event ;
    sh:message "OccupationRecord must have at most one :recordedAt, typed :Event." .

# No wiki source for :reportsOn today; kept so the shape stays faithful to the ontology.
shocc:reportsOn
    a sh:PropertyShape ;
    sh:path :reportsOn ;
    sh:maxCount 1 ;
    sh:class :Event ;
    sh:message "OccupationRecord must have at most one :reportsOn, typed :Event." .
