@prefix : <https://enslaved.org/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shpr: <http://enslaved.org/shapes/participant-role-record#> .

#   $env:JVM_ARGS = "-Xmx16G"
#   shacl validate --shapes src/phase5/shapes/participant_role_record_shapes.ttl --data out/phase3/participant_role.ttl --data out/phase3/cv_individuals.ttl --data out/phase3/temporal_extent.ttl --data out/phase3/event.ttl --data out/phase3/agent.ttl --data out/phase3/entity_with_provenance-old.ttl --data ontology/enslaved-v2.ttl | Out-File -Encoding utf8 out/phase5/participant_role_record_report.ttl

shpr:ParticipantRoleRecordShape
    a sh:NodeShape ;
    sh:targetClass :ParticipantRoleRecord ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property shpr:hasParticipantRoleType ,
                shpr:owningEvent ,
                shpr:owningAgent ,
                shpr:hasTemporalExtent ,
                shpr:isDirectlyBasedOn ,
                shpr:roleProvidedBy ,
                shpr:recordedAt ,
                shpr:reportsOn .

shpr:hasParticipantRoleType
    a sh:PropertyShape ;
    sh:path :hasParticipantRoleType ;
    sh:maxCount 1 ;
    sh:class :ParticipantRoleTypes ;
    sh:message "ParticipantRoleRecord must have at most one :hasParticipantRoleType, typed :ParticipantRoleTypes." .

shpr:owningEvent
    a sh:PropertyShape ;
    sh:path [ sh:inversePath :providesParticipantRole ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class :Event ;
    sh:message "ParticipantRoleRecord must be provided by exactly one :Event (inverse :providesParticipantRole)." .

shpr:owningAgent
    a sh:PropertyShape ;
    sh:path [ sh:alternativePath (
                :roleProvidedBy
                [ sh:inversePath :hasParticipantRoleRecord ]
                [ sh:inversePath :hasAgentRecord ]
            ) ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:class :Person ] [ sh:class :Organization ] [ sh:class :Agent ] ) ;
    sh:message "ParticipantRoleRecord must be provided by exactly one Agent (:roleProvidedBy)." .

shpr:hasTemporalExtent
    a sh:PropertyShape ;
    sh:path :hasTemporalExtent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:class :TemporalExtent ] [ sh:class :TimeSpan ] ) ;
    sh:severity sh:Warning ;
    sh:message "ParticipantRoleRecord must have exactly one :hasTemporalExtent, typed :TemporalExtent or :TimeSpan." .

shpr:isDirectlyBasedOn
    a sh:PropertyShape ;
    sh:path :isDirectlyBasedOn ;
    sh:maxCount 1 ;
    sh:class :EntityWithProvenance ;
    sh:message "ParticipantRoleRecord must have at most one :isDirectlyBasedOn, typed :EntityWithProvenance." .

shpr:recordedAt
    a sh:PropertyShape ;
    sh:path :recordedAt ;
    sh:maxCount 1 ;
    sh:class :Event ;
    sh:message "ParticipantRoleRecord must have at most one :recordedAt, typed :Event." .

shpr:reportsOn
    a sh:PropertyShape ;
    sh:path :reportsOn ;
    sh:maxCount 1 ;
    sh:class :Event ;
    sh:message "ParticipantRoleRecord must have at most one :reportsOn, typed :Event." .

shpr:roleProvidedBy
    a sh:PropertyShape ;
    sh:path :roleProvidedBy ;
    sh:maxCount 1 ;
    sh:message "ParticipantRoleRecord must have at most one :roleProvidedBy." .
